# ─── Speech-to-Text ───────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here   # alternative

# ─── LLM (choose one) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here       # Claude (Anthropic)
GROQ_API_KEY=your_groq_api_key_here                 # fast + free tier
# OPENAI_API_KEY=your_openai_api_key_here           # alternative

LLM_PROVIDER=anthropic                              # "anthropic" | "groq" | "openai"
LLM_MODEL=claude-3-5-sonnet-20241022                # claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022

# ─── Vector DB (ChromaDB) ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=msmarco_xi

# ─── Embedding ────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2                    # small, fast, 384-dim

# ─── Retrieval ────────────────────────────────────────────────────
TOP_K_RETRIEVE=10                                   # candidates before rerank
TOP_K_FINAL=3                                       # final chunks sent to LLM

# ─── Chunking ─────────────────────────────────────────────────────
CHUNKING_STRATEGY=sentence                          # "fixed" | "sentence" | "metadata"
CHUNK_SIZE=256                                      # tokens (for fixed strategy)
CHUNK_OVERLAP=32                                    # tokens overlap

# ─── App ──────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
